# 复制成 .env 后按需修改；.env 不入库

# 本地开发默认落在 backend/reading.db
# 线上由 docker-compose 注入：sqlite:////data/reading.db（4 个斜杠 = 绝对路径）
DATABASE_URL=sqlite:///./reading.db

# Phase 1 单用户模式使用的固定用户 id；Phase 3 接入登录后作废
SINGLE_USER_ID=1

# 邮件验证码（注册 / 找回密码），走 Resend。两个都配了才真的发信。
# 不配时：本地 http 开发把验证码打印在后端日志里；SESSION_COOKIE_SECURE=true（线上）
# 则邮箱注册和找回返回 503，不会把验证码写进日志。
# RESEND_API_KEY=re_...
# MAIL_FROM=Foglight <no-reply@你在 Resend 验证过的域名>
